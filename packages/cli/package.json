{
  "name": "@agent-nexus/cli",
  "version": "1.3.0",
  "description": "Official CLI for the Nexus AI agent platform.",
  "license": "MIT",
  "keywords": [
    "nexus",
    "nexusgpt",
    "ai-agents",
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/agent-nexus.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/NexusGPT/agent-nexus/tree/main/packages/cli#readme",
  "bin": {
    "nexus": "dist/index.js"
  },
  "files": [
    "dist",
    "COMPATIBILITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen:audit-types": "tsx scripts/generate-vibe-audit-event-types.ts",
    "gen:cli-surface": "tsx scripts/generate-cli-surface.ts",
    "gen:cli-surface-baseline": "tsx scripts/generate-cli-surface-baseline.ts",
    "gen:id-graph-ledger": "tsx scripts/generate-id-graph-ledger.ts",
    "gen:contract-help": "tsx scripts/generate-contract-help.ts",
    "gen:json-shape": "tsx scripts/generate-json-shape.ts",
    "gen:skills": "tsx scripts/bundle-skills.ts",
    "check:skills-lock": "tsx scripts/check-skills-lock.ts",
    "check:skills-drift": "tsx scripts/check-skills-drift.ts",
    "build": "tsup",
    "build:refresh-skills": "pnpm run gen:skills && tsup",
    "dev": "tsup --watch",
    "test:auth": "tsx scripts/test-auth-login.ts",
    "id-thread": "tsx scripts/id-thread-sweep.ts",
    "id-thread:plan": "tsx scripts/id-thread-sweep.ts --plan",
    "test": "vitest run",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit && node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 9",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@agent-nexus/sdk": "workspace:*",
    "@types/node": "24.6.2",
    "jszip": "^3.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  }
}
