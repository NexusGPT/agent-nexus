{
  "name": "@agent-nexus/sdk",
  "version": "3.0.0",
  "description": "Official TypeScript SDK for the Nexus Public API — manage agents, tools, folders, and versions programmatically.",
  "license": "MIT",
  "keywords": [
    "nexus",
    "nexusgpt",
    "ai-agents",
    "sdk",
    "typescript",
    "api-client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NexusGPT/agent-nexus",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/NexusGPT/agent-nexus/tree/main/packages/sdk#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/assert-declarations.mjs dist && node ../../scripts/assert-published-imports.mjs dist",
    "dev": "tsup --watch --onSuccess \"tsc -p tsconfig.build.json\"",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit && node ../../node_modules/typescript7/bin/tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm run build",
    "gen:response-contract": "tsx scripts/generate-response-contract.ts"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  }
}
