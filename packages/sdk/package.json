{
  "name": "@agent-nexus/sdk",
  "version": "0.1.31",
  "description": "Official TypeScript SDK for the Nexus Public API — manage agents, tools, folders, and versions programmatically.",
  "license": "MIT",
  "keywords": [
    "nexus",
    "nexusgpt",
    "ai-agents",
    "sdk",
    "typescript",
    "api-client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NexusGPT/agent-nexus",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/NexusGPT/agent-nexus/tree/main/packages/sdk#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
