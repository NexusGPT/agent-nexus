{
  "compilerOptions": {
    "target": "es2020",
    // ESM-authored: the tests resolve fixtures via `import.meta.url`, and vitest
    // runs them as ESM. This governs typechecking only — tsup owns the build and
    // emits BOTH cjs and esm, so the build image's `require()` path is unaffected
    // (proved by the bundle-isolation check in the PR).
    "module": "esnext",
    "lib": ["es2020"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    // The package root, not `src`: this program is `typecheck`'s, which never
    // emits, and it reads `vitest.config.ts` beside `src/` — a `src` rootDir
    // refuses that with TS6059. `tsconfig.build.json` is the emitting program and
    // sets `rootDir: "./src"` itself, so the published layout is unchanged.
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
